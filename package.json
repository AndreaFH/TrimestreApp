{
  "name": "trimestre-app",
  "productName": "Ingresos y Gastos Trimestrales",
  "version": "1.0.0",
  "description": "Aplicación de escritorio para registro de ingresos y gastos trimestrales",
  "main": "dist/main/index.js",
  "author": "Andrea",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "test": "tsc -p tsconfig.json && node --test tests/",
    "test:watch": "vitest",
    "lint": "eslint src tests --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.ts\" \"src/**/*.tsx\" \"tests/**/*.ts\"",
    "build:main": "tsc -p tsconfig.node.json",
    "electron:dev": "npm run build:main && concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "electron:build": "npm run build && electron-builder --win --x64",
    "dist": "electron-builder --win --x64"
  },
  "dependencies": {
    "@chakra-ui/icons": "^2.2.4",
    "@chakra-ui/react": "^3.37.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "better-sqlite3": "^11.10.0",
    "call-bind-apply-helpers": "^1.0.2",
    "docx": "^9.5.1",
    "emotion": "^11.0.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^14.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@eslint/js": "^9.25.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.0",
    "vite": "^6.3.5",
    "vitest": "^3.1.3",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "es.andrea.trimestre-app",
    "productName": "Ingresos y Gastos Trimestrales",
    "files": [
      "dist/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.64.5"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node"
  }
}
